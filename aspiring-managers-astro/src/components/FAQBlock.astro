---
import { ChevronDown } from "lucide-react";
import type { FaqItem } from "@/components/content/siteContent";
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---

<div class="rounded-[28px] border border-[#d8dee9] bg-white/95 px-5 py-3 shadow-[0_30px_60px_-48px_rgba(20,33,60,0.3)] sm:px-8">
  {items.map((item, index) => (
    <details name="homepage-faq" open={index === 0} class="group border-b last:border-b-0">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-md py-5 text-base font-semibold text-[#14213c] focus-visible:outline-ring sm:text-lg [&::-webkit-details-marker]:hidden">
        {item.question}
        <ChevronDown className="size-4 shrink-0 translate-y-0.5 text-muted-foreground transition-transform group-open:rotate-180" />
      </summary>
      <p class="pb-4 text-sm leading-7 text-[#5a6b84] sm:text-base">{item.answer}</p>
    </details>
  ))}
</div>
